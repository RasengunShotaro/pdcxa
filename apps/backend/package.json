{
  "name": "@pdcxa/backend",
  "exports": {
    "./hc": {
      "import": {
        "default": "./dist/hc.js",
        "types": "./dist/hc.d.ts"
      }
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=./drizzle/drizzle.config.ts",
    "drizzle:introspect": "drizzle-kit introspect --config=./drizzle/drizzle.config.ts",
    "deploy": "wrangler deploy --minify",
    "deploy:dev": "wrangler deploy --env=dev --minify",
    "openapi:generate": "bun run scripts/gen-openapi.ts",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check --error-on-warnings",
    "test": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/hono": "^0.1.82",
    "@hono/zod-openapi": "^1.6.3",
    "@neondatabase/serverless": "^1.1.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "effect": "^3.22.2",
    "hono": "^4.13.8",
    "uuidv7": "^1.2.1",
    "wasm-image-optimization": "^2.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pdcxa/common-dev-packages": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "vitest": "^4.1.11"
  }
}
