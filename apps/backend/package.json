{
  "name": "@pdcxa/backend",
  "exports": {
    "./hc": {
      "import": {
        "default": "./dist/hc.js",
        "types": "./dist/hc.d.ts"
      }
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=./drizzle/drizzle.config.ts",
    "drizzle:introspect": "drizzle-kit introspect --config=./drizzle/drizzle.config.ts",
    "deploy": "wrangler deploy --minify",
    "deploy:dev": "wrangler deploy --env=dev --minify",
    "openapi:generate": "bun run scripts/gen-openapi.ts",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.1.1",
    "@hono/zod-openapi": "^1.5.1",
    "@neondatabase/serverless": "^1.1.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.0",
    "hono": "^4.12.32",
    "uuidv7": "^1.2.1",
    "wasm-image-optimization": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pdcxa/common-dev-packages": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "vitest": "^4.1.10"
  }
}
