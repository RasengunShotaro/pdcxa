{
  "name": "@pdcxa/backend",
  "exports": {
    "./hc": {
      "import": {
        "default": "./dist/hc.js",
        "types": "./dist/hc.d.ts"
      }
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=./drizzle/drizzle.config.ts",
    "drizzle:introspect": "drizzle-kit introspect --config=./drizzle/drizzle.config.ts",
    "deploy": "wrangler deploy --minify",
    "deploy:dev": "wrangler deploy --env=dev --minify",
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.0.3",
    "@hono/standard-validator": "^0.1.5",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "uuidv7": "^1.0.2",
    "wasm-image-optimization": "^1.3.0"
  },
  "devDependencies": {
    "@pdcxa/common-dev-packages": "workspace:*",
    "drizzle-kit": "^0.31.4"
  }
}
