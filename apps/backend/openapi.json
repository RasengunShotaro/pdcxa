              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "user_2abc"
                    },
                    "firstName": {
                      "type": "string",
                      "nullable": true,
                      "example": "太郎"
                    },
                    "lastName": {
                      "type": "string",
                      "nullable": true,
                      "example": "田中"
                    },
                    "imageUrl": {
                      "type": "string",
                      "example": "https://img.clerk.com/example.png"
                    },
                    "userName": {
                      "type": "string",
                      "nullable": true,
                      "example": "taro"
                    }
                  },
                  "required": [
                    "id",
                    "firstName",
                    "lastName",
                    "imageUrl",
                    "userName"
                  ],
                  "example": {
                    "id": "user_2abc",
                    "firstName": "太郎",
                    "lastName": "田中",
                    "imageUrl": "https://img.clerk.com/example.png",
                    "userName": "taro"
                  }
                }
