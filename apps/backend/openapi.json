    "/pd": {
      "get": {
        "operationId": "fetchPds",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "0190d2c0-0000-7000-8000-000000000001"
            },
            "required": false,
            "name": "pdId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "taro"
            },
            "required": false,
            "name": "userName",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "0190d2c0-0000-7000-8000-000000000002"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "PD一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
