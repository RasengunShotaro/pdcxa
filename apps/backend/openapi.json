    "/pd/stats/weekly": {
      "get": {
        "operationId": "fetchWeeklyStats",
        "responses": {
          "200": {
            "description": "PD週間統計",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "range": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string",
                          "example": "2026-06-18"
                        },
                        "end": {
                          "type": "string",
                          "example": "2026-06-24"
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "example": {
                        "start": "2026-06-18",
                        "end": "2026-06-24"
                      }
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "pdCount": {
                          "type": "number",
                          "example": 20
                        },
                        "rePdCount": {
                          "type": "number",
                          "example": 30
                        },
                        "likeCount": {
                          "type": "number",
                          "example": 50
                        },
                        "activeAuthorCount": {
                          "type": "number",
                          "example": 4
                        },
                        "averagePdPerAuthor": {
                          "type": "number",
                          "example": 5
                        }
                      },
                      "required": [
                        "pdCount",
                        "rePdCount",
                        "likeCount",
                        "activeAuthorCount",
                        "averagePdPerAuthor"
                      ],
                      "example": {
                        "pdCount": 20,
                        "rePdCount": 30,
                        "likeCount": 50,
                        "activeAuthorCount": 4,
                        "averagePdPerAuthor": 5
                      }
                    },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "example": "2026-06-24"
                          },
                          "pdCount": {
                            "type": "number",
                            "example": 5
                          },
                          "rePdCount": {
                            "type": "number",
                            "example": 8
                          },
                          "likeCount": {
                            "type": "number",
                            "example": 12
                          }
                        },
                        "required": [
                          "date",
                          "pdCount",
                          "rePdCount",
                          "likeCount"
                        ],
                        "example": {
                          "date": "2026-06-24",
                          "pdCount": 5,
                          "rePdCount": 8,
                          "likeCount": 12
                        }
                      },
                      "example": [
                        {
                          "date": "2026-06-24",
                          "pdCount": 5,
                          "rePdCount": 8,
                          "likeCount": 12
                        }
                      ]
                    },
                    "rankings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "userId": {
                            "type": "string",
                            "example": "user_2abc"
                          },
                          "pdCount": {
                            "type": "number",
                            "example": 5
                          },
                          "rePdCount": {
                            "type": "number",
                            "example": 8
                          },
                          "likeCount": {
                            "type": "number",
                            "example": 12
                          }
                        },
                        "required": [
                          "userId",
                          "pdCount",
                          "rePdCount",
                          "likeCount"
                        ],
                        "example": {
                          "userId": "user_2abc",
                          "pdCount": 5,
                          "rePdCount": 8,
                          "likeCount": 12
                        }
                      },
                      "example": [
                        {
                          "userId": "user_2abc",
                          "pdCount": 5,
                          "rePdCount": 8,
                          "likeCount": 12
                        }
                      ]
                    }
                  },
                  "required": [
                    "range",
                    "totals",
                    "daily",
                    "rankings"
                  ],
                  "example": {
                    "range": {
                      "start": "2026-06-18",
                      "end": "2026-06-24"
                    },
                    "totals": {
                      "pdCount": 20,
                      "rePdCount": 30,
                      "likeCount": 50,
                      "activeAuthorCount": 4,
                      "averagePdPerAuthor": 5
                    },
                    "daily": [
                      {
                        "date": "2026-06-24",
                        "pdCount": 5,
                        "rePdCount": 8,
                        "likeCount": 12
                      }
                    ],
                    "rankings": [
                      {
                        "userId": "user_2abc",
                        "pdCount": 5,
                        "rePdCount": 8,
                        "likeCount": 12
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
