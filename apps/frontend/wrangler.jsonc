{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-04-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "env": {
    "dev": {
      "name": "pdcxa-dev",
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "dev"
        }
      ]
    }
  },
  "main": ".open-next/worker.js",
  "name": "pdcxa",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "prod"
    }
  ]
}
