{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-04-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "pdcxa.com",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "pdcxa-dev",
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "dev"
        }
      ],
      "services": [
        {
          "binding": "BFF",
          "service": "bff"
        }
      ]
    }
  },
  "main": ".open-next/worker.js",
  "name": "pdcxa",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "prod"
    }
  ],
  "services": [
    {
      "binding": "BFF",
      "service": "bff"
    }
  ]
}
