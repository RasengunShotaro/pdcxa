{
  "name": "@pdcxa/frontend",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env=dev",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:generate": "cd ../backend && bun run openapi:generate && cd ../frontend && orval --config ./orval.config.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest --project unit",
    "test:storybook": "NEXT_PUBLIC_API_MOCKING=enabled vitest --project storybook",
    "storybook": "NEXT_PUBLIC_API_MOCKING=enabled storybook dev -p 6006",
    "build-storybook": "NEXT_PUBLIC_API_MOCKING=enabled storybook build",
    "doctor": "react-doctor --verbose"
  },
  "dependencies": {
    "@clerk/localizations": "^4.13.8",
    "@clerk/nextjs": "^7.6.1",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^5.5.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@pdcxa/backend": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@pdcxa/common-dev-packages": "workspace:*",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "orval": "^8.23.0",
    "playwright": "^1.62.0",
    "postcss": "^8",
    "react-doctor": "^0.9.2",
    "storybook": "^10.5.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
