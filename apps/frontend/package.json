{
  "name": "@pdcxa/frontend",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env=dev",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:generate": "cd ../backend && bun run openapi:generate && cd ../frontend && orval --config ./orval.config.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest --project unit",
    "test:storybook": "NEXT_PUBLIC_API_MOCKING=enabled vitest --project storybook",
    "storybook": "NEXT_PUBLIC_API_MOCKING=enabled storybook dev -p 6006",
    "build-storybook": "NEXT_PUBLIC_API_MOCKING=enabled storybook build",
    "doctor": "react-doctor --verbose"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.6",
    "@clerk/nextjs": "^7.9.25",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^7.0.3",
    "@opennextjs/cloudflare": "^1.20.16",
    "@pdcxa/backend": "workspace:*",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "linkify-react": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@pdcxa/common-dev-packages": "workspace:*",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-onboarding": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "orval": "^8.46.0",
    "playwright": "^1.65.0",
    "postcss": "^8",
    "react-doctor": "^0.9.22",
    "storybook": "^10.6.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
